# Per-developer config (resource ids, real bundle ids, etc.)
# Committed source-of-truth lives in *.sample siblings.
server/wrangler.toml

# Node / Cloudflare
node_modules/
server/.wrangler/
server/dist/
.npm/
.yarn/

# Xcode / XcodeGen
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build/
ios/DerivedData/
ios/Pods/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xcsettings
# Info.plist + entitlements files are written by XcodeGen from project.yml.
# project.yml itself is per-developer (Team ID, bundle ids, App Group);
# the committed source-of-truth is project.yml.sample.
ios/project.yml
ios/Resources/App/Info.plist
ios/Resources/Widgets/Info.plist
ios/Resources/TV/Info.plist
ios/Resources/App/ZeroZeroWidget.entitlements
ios/Resources/Widgets/Widgets.entitlements
ios/Resources/TV/ZeroZeroWidgetTV.entitlements

