# Secrets — never commit
examples/env.sh
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example
.envrc
*.p8
*.pem
*.key
*.p12
*.pfx
*.der
*.mobileprovision
*.provisionprofile
*.cer
*.csr
*.jks
*.keystore

# Per-developer config (resource ids, real bundle ids, etc.)
# Committed source-of-truth lives in *.sample siblings.
server/wrangler.toml

# Node / Cloudflare
node_modules/
server/.wrangler/
server/dist/
.npm/
.yarn/

# Xcode / XcodeGen
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build/
ios/DerivedData/
ios/Pods/
*.ipa
*.xcarchive/
*.dSYM/
*.xcresult/
ExportOptions.plist
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xcsettings
# Info.plist + entitlements files are written by XcodeGen from project.yml.
# project.yml itself is per-developer (Team ID, bundle ids, App Group);
# the committed source-of-truth is project.yml.sample.
ios/project.yml
# Globs, not a list: naming each one meant a new target's generated plist and
# entitlements were committed by default, carrying the real bundle id and App
# Group the rest of this file exists to keep out.
ios/Resources/*/Info.plist
ios/Resources/*/*.entitlements

# macOS
.DS_Store

# Editor
.claude/
.vscode/
.idea/
*.swp
