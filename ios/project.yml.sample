name: ZeroZeroWidget
options:
  bundleIdPrefix: com.example
  deploymentTarget:
    iOS: "26.0"
    tvOS: "26.0"
  createIntermediateGroups: true
  generateEmptyDirectories: true

settings:
  base:
    SWIFT_VERSION: 5.10
    MARKETING_VERSION: "1.0"
    CURRENT_PROJECT_VERSION: "1"
    DEVELOPMENT_TEAM: ""                         # TODO: set to your Apple Developer Team ID
    CODE_SIGN_STYLE: Automatic
    ENABLE_USER_SCRIPT_SANDBOXING: NO
    IPHONEOS_DEPLOYMENT_TARGET: "26.0"
    # Compile-time gates. Each flag listed here compiles a feature in; removing
    # one strips its UI and API calls out of the build entirely.
    #
    #   ZW_SHARING_ENABLED        cross-tenant sharing
    #   ZW_SUBSCRIPTIONS_ENABLED  App Store subscriptions (StoreKit, paywall)
    #
    # ZW_SUBSCRIPTIONS_ENABLED is deliberately NOT set, here or in any
    # committed configuration. Turning it on also requires SUBSCRIPTIONS_ENABLED
    # and SUBSCRIPTION_PRODUCT_IDS on the server, which is where the app reads
    # the product list from — a build with the flag and a server that sells
    # nothing shows an empty paywall.
    SWIFT_ACTIVE_COMPILATION_CONDITIONS: ZW_SHARING_ENABLED
    # Settings -> Developer. NO for anything shippable; the screenshot
    # run overrides it with `xcodebuild test ZW_DEBUG_TOOLS=YES`.
    ZW_DEBUG_TOOLS: NO

targets:
  ZeroZeroWidgetApp:
    type: application
    platform: iOS
    sources:
      - path: Sources/App
      - path: Sources/Shared
      - path: Resources/App/Assets.xcassets
    info:
      path: Resources/App/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        UILaunchScreen:
          {}
        UIApplicationSceneManifest:
          UIApplicationSupportsMultipleScenes: false
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        ITSAppUsesNonExemptEncryption: false
        # Scanning a shared link's QR code is the only use of the camera.
        NSCameraUsageDescription: 00Widget uses the camera to scan a QR code when someone shares a card or Live Activity with you.
        NSSupportsLiveActivities: true
        NSSupportsLiveActivitiesFrequentUpdates: true
        UIBackgroundModes:
          - remote-notification
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        UISupportedInterfaceOrientations~ipad:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        ZWAppGroupIdentifier: group.com.example.zerozerowidget   # must match the app-group entitlement below
        ZWKeychainAccessGroup: $(AppIdentifierPrefix)com.example.zerozerowidget
        ZWDefaultServerBaseURL: ""                               # optional per-developer default; keep empty in sample
        ZWAppleLoginEnabled: false                                # set true when backend Apple app login is enabled
        ZWDebugToolsEnabled: $(ZW_DEBUG_TOOLS)
    entitlements:
      path: Resources/App/ZeroZeroWidget.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerowidget
        keychain-access-groups:
          - $(AppIdentifierPrefix)com.example.zerozerowidget
        com.apple.developer.applesignin:
          - Default
        # Must be the host serving /.well-known/apple-app-site-association, and
        # its APPLE_APP_ID var must be this target's <Team ID>.<bundle id>.
        # Append `?mode=developer` while testing against an unreleased AASA —
        # it bypasses Apple's CDN cache, and must come back out before release.
        com.apple.developer.associated-domains:
          - applinks:api.example.com
        aps-environment: development
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget
        INFOPLIST_KEY_UIApplicationSupportsMultipleScenes: NO
        INFOPLIST_KEY_UILaunchScreen_Generation: YES
        TARGETED_DEVICE_FAMILY: "1,2"
    dependencies:
      - target: ZeroZeroWidgetWidgets
        embed: true
      - target: ZeroZeroWidgetClip
        embed: true

  ZeroZeroWidgetWidgets:
    type: app-extension
    platform: iOS
    sources:
      - path: Sources/Widgets
      - path: Sources/Shared
      - path: Resources/Widgets/Assets.xcassets
    info:
      path: Resources/Widgets/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
        ZWAppGroupIdentifier: group.com.example.zerozerowidget   # must match the app target's value
        ZWKeychainAccessGroup: $(AppIdentifierPrefix)com.example.zerozerowidget
        ZWDefaultServerBaseURL: ""                               # optional per-developer default; keep empty in sample
    entitlements:
      path: Resources/Widgets/Widgets.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerowidget
        keychain-access-groups:
          - $(AppIdentifierPrefix)com.example.zerozerowidget
        aps-environment: development                  # required for WidgetKit push (iOS 26+)
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.widgets
        INFOPLIST_KEY_CFBundleDisplayName: 00Widget


  # App Clip. Launched from a guest link's QR code without installing anything,
  # to run one shared Live Activity. Apple forbids Home Screen widgets in a
  # clip; a Live-Activity-only widget extension is the documented carve-out.
  ZeroZeroWidgetClip:
    type: application.on-demand-install-capable
    platform: iOS
    sources:
      - path: Sources/Clip
      - path: Sources/Shared
      - path: Resources/Clip/Assets.xcassets
    info:
      path: Resources/Clip/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        UILaunchScreen:
          {}
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        ITSAppUsesNonExemptEncryption: false
        # XcodeGen writes APPL for `application` but not for
        # `application.on-demand-install-capable`; App Store Connect rejects
        # the upload without it (error 90183).
        CFBundlePackageType: APPL
        # Required alongside the catalog for any target built with the iOS 11+
        # SDK (error 90713).
        CFBundleIconName: AppIcon
        NSSupportsLiveActivities: true
        NSAppClip:
          # The clip asks for nothing beyond the link it was opened with.
          NSAppClipRequestEphemeralUserNotification: false
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        ZWAppGroupIdentifier: group.com.example.zerozerowidget
        ZWDefaultServerBaseURL: ""
    entitlements:
      path: Resources/Clip/ZeroZeroWidgetClip.entitlements
      properties:
        com.apple.developer.parent-application-identifiers:
          - $(AppIdentifierPrefix)com.example.zerozerowidget
        com.apple.developer.associated-domains:
          - applinks:api.example.com
        com.apple.security.application-groups:
          - group.com.example.zerozerowidget
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.Clip
        TARGETED_DEVICE_FAMILY: "1,2"
        INFOPLIST_KEY_UILaunchScreen_Generation: YES
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
    dependencies:
      - target: ZeroZeroWidgetClipLiveActivity
        embed: true

  # Live Activities only. Apple: "Reserve widgets that appear on the Home
  # Screen, Lock Screen, or in Today View for your full app." Compiles the one
  # shared Live Activity view rather than Sources/Widgets wholesale, because
  # that directory's WidgetBundle.swift is the full app's @main.
  ZeroZeroWidgetClipLiveActivity:
    type: app-extension
    platform: iOS
    sources:
      - path: Sources/ClipWidgets
      - path: Sources/Widgets/LiveActivityWidget.swift
      - path: Sources/Shared
    info:
      path: Resources/ClipWidgets/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
        ZWAppGroupIdentifier: group.com.example.zerozerowidget
        ZWDefaultServerBaseURL: ""
    entitlements:
      path: Resources/ClipWidgets/ClipLiveActivity.entitlements
      properties:
        # The App Clip Extension capability. Without it the clip cannot carry
        # the widget extension at all.
        com.apple.developer.on-demand-install-capable: true
        com.apple.security.application-groups:
          - group.com.example.zerozerowidget
    settings:
      base:
        # Must be prefixed by the App Clip's bundle id, not the app's.
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.Clip.liveactivities

  # Marketing-screenshot capture only — not part of any shipping build. The
  # dedicated ZeroZeroWidgetScreenshots scheme below keeps it out of the
  # app/tvOS schemes the release scripts archive with.
  ZeroZeroWidgetUITests:
    type: bundle.ui-testing
    platform: iOS
    sources:
      - path: UITests
    dependencies:
      - target: ZeroZeroWidgetApp
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.uitests
        TEST_TARGET_NAME: ZeroZeroWidgetApp
        # Required once the target is code signed, which the re-signed
        # screenshot run does; without signing Xcode never asks for it.
        GENERATE_INFOPLIST_FILE: YES

  ZeroZeroWidgetTVUITests:
    type: bundle.ui-testing
    platform: tvOS
    sources:
      - path: TVUITests
    dependencies:
      - target: ZeroZeroWidgetTV
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.tvuitests
        TEST_TARGET_NAME: ZeroZeroWidgetTV
        GENERATE_INFOPLIST_FILE: YES

  ZeroZeroWidgetTV:
    type: application
    platform: tvOS
    sources:
      - path: Sources/TV
      - path: Sources/Shared
      - path: Resources/TV/Assets.xcassets
    info:
      path: Resources/TV/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        ITSAppUsesNonExemptEncryption: false
        UIUserInterfaceStyle: Dark
        ZWDefaultServerBaseURL: ""                               # optional per-developer default; keep empty in sample
        ZWAppleLoginEnabled: false                                # set true when backend Apple app login is enabled
        ZWDebugToolsEnabled: $(ZW_DEBUG_TOOLS)
        TVTopShelfImage:
          TVTopShelfPrimaryImage: Top Shelf Image
          TVTopShelfPrimaryImageWide: Top Shelf Image Wide
    entitlements:
      path: Resources/TV/ZeroZeroWidgetTV.entitlements
      properties:
        com.apple.developer.applesignin:
          - Default
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget
        TARGETED_DEVICE_FAMILY: "3"
        TVOS_DEPLOYMENT_TARGET: "26.0"
        ASSETCATALOG_COMPILER_APPICON_NAME: "App Icon & Top Shelf Image"
        ASSETCATALOG_COMPILER_LAUNCHIMAGE_NAME: LaunchImage

# Schemes are declared explicitly: adding any `schemes:` entry turns off Xcode's
# autocreation for every target, which silently removed the ZeroZeroWidgetApp
# scheme that build-sim.sh and upload-testflight.sh archive with. Keep the app
# and tvOS schemes here so that stays deterministic.
schemes:
  ZeroZeroWidgetApp:
    build:
      targets:
        ZeroZeroWidgetApp: all
    run:
      config: Debug
    test:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release

  ZeroZeroWidgetTV:
    build:
      targets:
        ZeroZeroWidgetTV: all
    run:
      config: Debug
    test:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release

  ZeroZeroWidgetClip:
    build:
      targets:
        ZeroZeroWidgetClip: all
    run:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release

  # Marketing screenshots only. Separate scheme so the UI test target never
  # enters an archive.
  ZeroZeroWidgetScreenshots:
    build:
      targets:
        ZeroZeroWidgetApp: all
        ZeroZeroWidgetUITests: [test]
    test:
      config: Debug
      targets:
        - ZeroZeroWidgetUITests

  ZeroZeroWidgetTVScreenshots:
    build:
      targets:
        ZeroZeroWidgetTV: all
        ZeroZeroWidgetTVUITests: [test]
    test:
      config: Debug
      targets:
        - ZeroZeroWidgetTVUITests
