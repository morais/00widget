name: ZeroZeroWidget
options:
  bundleIdPrefix: com.example
  deploymentTarget:
    iOS: "26.0"
    tvOS: "26.0"
  createIntermediateGroups: true
  generateEmptyDirectories: true

settings:
  base:
    SWIFT_VERSION: 5.10
    MARKETING_VERSION: "1.0"
    CURRENT_PROJECT_VERSION: "1"
    DEVELOPMENT_TEAM: ""                         # TODO: set to your Apple Developer Team ID
    CODE_SIGN_STYLE: Automatic
    ENABLE_USER_SCRIPT_SANDBOXING: NO
    IPHONEOS_DEPLOYMENT_TARGET: "26.0"
    # Compile-time gate for the cross-tenant sharing feature. Remove the flag
    # to strip every Sharing UI and API call out of the build.
    SWIFT_ACTIVE_COMPILATION_CONDITIONS: ZW_SHARING_ENABLED
    # Settings -> Developer. NO for anything shippable; the screenshot
    # run overrides it with `xcodebuild test ZW_DEBUG_TOOLS=YES`.
    ZW_DEBUG_TOOLS: NO

targets:
  ZeroZeroWidgetApp:
    type: application
    platform: iOS
    sources:
      - path: Sources/App
      - path: Sources/Shared
      - path: Resources/App/Assets.xcassets
    info:
      path: Resources/App/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        UILaunchScreen:
          {}
        UIApplicationSceneManifest:
          UIApplicationSupportsMultipleScenes: false
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        ITSAppUsesNonExemptEncryption: false
        NSSupportsLiveActivities: true
        NSSupportsLiveActivitiesFrequentUpdates: true
        UIBackgroundModes:
          - remote-notification
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        UISupportedInterfaceOrientations~ipad:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        ZWAppGroupIdentifier: group.com.example.zerozerowidget   # must match the app-group entitlement below
        ZWKeychainAccessGroup: $(AppIdentifierPrefix)com.example.zerozerowidget
        ZWDefaultServerBaseURL: ""                               # optional per-developer default; keep empty in sample
        ZWAppleLoginEnabled: false                                # set true when backend Apple app login is enabled
        ZWDebugToolsEnabled: $(ZW_DEBUG_TOOLS)
    entitlements:
      path: Resources/App/ZeroZeroWidget.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerowidget
        keychain-access-groups:
          - $(AppIdentifierPrefix)com.example.zerozerowidget
        com.apple.developer.applesignin:
          - Default
        aps-environment: development
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget
        INFOPLIST_KEY_UIApplicationSupportsMultipleScenes: NO
        INFOPLIST_KEY_UILaunchScreen_Generation: YES
        TARGETED_DEVICE_FAMILY: "1,2"
    dependencies:
      - target: ZeroZeroWidgetWidgets
        embed: true

  ZeroZeroWidgetWidgets:
    type: app-extension
    platform: iOS
    sources:
      - path: Sources/Widgets
      - path: Sources/Shared
      - path: Resources/Widgets/Assets.xcassets
    info:
      path: Resources/Widgets/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
        ZWAppGroupIdentifier: group.com.example.zerozerowidget   # must match the app target's value
        ZWKeychainAccessGroup: $(AppIdentifierPrefix)com.example.zerozerowidget
        ZWDefaultServerBaseURL: ""                               # optional per-developer default; keep empty in sample
    entitlements:
      path: Resources/Widgets/Widgets.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerowidget
        keychain-access-groups:
          - $(AppIdentifierPrefix)com.example.zerozerowidget
        aps-environment: development                  # required for WidgetKit push (iOS 26+)
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.widgets
        INFOPLIST_KEY_CFBundleDisplayName: 00Widget

  # Marketing-screenshot capture only — not part of any shipping build. The
  # dedicated ZeroZeroWidgetScreenshots scheme below keeps it out of the
  # app/tvOS schemes the release scripts archive with.
  ZeroZeroWidgetUITests:
    type: bundle.ui-testing
    platform: iOS
    sources:
      - path: UITests
    dependencies:
      - target: ZeroZeroWidgetApp
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget.uitests
        TEST_TARGET_NAME: ZeroZeroWidgetApp
        # Required once the target is code signed, which the re-signed
        # screenshot run does; without signing Xcode never asks for it.
        GENERATE_INFOPLIST_FILE: YES

  ZeroZeroWidgetTV:
    type: application
    platform: tvOS
    sources:
      - path: Sources/TV
      - path: Sources/Shared
      - path: Resources/TV/Assets.xcassets
    info:
      path: Resources/TV/Info.plist
      properties:
        CFBundleDisplayName: 00Widget
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        ITSAppUsesNonExemptEncryption: false
        UIUserInterfaceStyle: Dark
        ZWDefaultServerBaseURL: ""                               # optional per-developer default; keep empty in sample
        ZWAppleLoginEnabled: false                                # set true when backend Apple app login is enabled
        ZWDebugToolsEnabled: $(ZW_DEBUG_TOOLS)
        TVTopShelfImage:
          TVTopShelfPrimaryImage: Top Shelf Image
          TVTopShelfPrimaryImageWide: Top Shelf Image Wide
    entitlements:
      path: Resources/TV/ZeroZeroWidgetTV.entitlements
      properties:
        com.apple.developer.applesignin:
          - Default
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerowidget
        TARGETED_DEVICE_FAMILY: "3"
        TVOS_DEPLOYMENT_TARGET: "26.0"
        ASSETCATALOG_COMPILER_APPICON_NAME: "App Icon & Top Shelf Image"
        ASSETCATALOG_COMPILER_LAUNCHIMAGE_NAME: LaunchImage

# Schemes are declared explicitly: adding any `schemes:` entry turns off Xcode's
# autocreation for every target, which silently removed the ZeroZeroWidgetApp
# scheme that build-sim.sh and upload-testflight.sh archive with. Keep the app
# and tvOS schemes here so that stays deterministic.
schemes:
  ZeroZeroWidgetApp:
    build:
      targets:
        ZeroZeroWidgetApp: all
    run:
      config: Debug
    test:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release

  ZeroZeroWidgetTV:
    build:
      targets:
        ZeroZeroWidgetTV: all
    run:
      config: Debug
    test:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release

  # Marketing screenshots only. Separate scheme so the UI test target never
  # enters an archive.
  ZeroZeroWidgetScreenshots:
    build:
      targets:
        ZeroZeroWidgetApp: all
        ZeroZeroWidgetUITests: [test]
    test:
      config: Debug
      targets:
        - ZeroZeroWidgetUITests
