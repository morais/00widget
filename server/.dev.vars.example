# Copy this file to .dev.vars (gitignored) and fill in real values for local dev.
# In production these are set with `wrangler secret put <NAME>`.

# Comma-separated bearer API keys accepted by the Worker.
API_KEYS="dev-key-1"

# APNs token-based auth — leave blank if you're not sending push notifications locally.
APNS_TEAM_ID=""
APNS_KEY_ID=""
# The private key in PEM form. Wrap in double quotes and preserve \n line breaks.
# Example: APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTA...\n-----END PRIVATE KEY-----\n"
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="com.example.zerowidget"
# "sandbox" for debug builds, "production" for App Store / TestFlight.
APNS_ENV="sandbox"

# --- Admin dashboard (Sign in with Apple) ---
# All four are required to enable /admin. Setup walkthrough is in server/README.md.
APPLE_SIGN_IN_CLIENT_ID=""              # Services ID, e.g. com.example.zerozerowidget.signin
APPLE_SIGN_IN_REDIRECT_URI=""           # full URL of /admin/auth/apple/callback
ADMIN_EMAILS=""                         # comma-separated emails allowed to sign in
SESSION_SECRET=""                       # any random 32+ char string; rotates the admin cookie
