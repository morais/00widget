# Copy this file to .dev.vars (gitignored) and fill in real values for local dev.
# In production these are set with `wrangler secret put <NAME>`.
#
# Non-secret toggles (APNS_ENV, SHARING_ENABLED) live in wrangler.toml [vars],
# not here — see wrangler.toml.sample.

# Comma-separated bootstrap tokens for the admin API-token fallback login.
# These are not accepted by /v1/*; create tenant API tokens from /admin.
API_KEYS=""

# APNs token-based auth — leave blank if you're not sending push notifications locally.
APNS_TEAM_ID=""
APNS_KEY_ID=""
# The private key in PEM form. Wrap in double quotes and preserve \n line breaks.
# Example: APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTA...\n-----END PRIVATE KEY-----\n"
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="com.example.zerozerowidget"
# "sandbox" for debug builds, "production" for App Store / TestFlight.
APNS_ENV="sandbox"

# --- Admin dashboard ---
# Two sign-in methods, either is sufficient. Setup walkthrough: server/README.md.
#
# Sign in with Apple — required for production. All four below.
APPLE_SIGN_IN_CLIENT_ID=""              # Services ID, e.g. com.example.zerozerowidget.signin
APPLE_SIGN_IN_REDIRECT_URI=""           # full URL of /admin/auth/apple/callback
ADMIN_EMAILS=""                         # comma-separated emails allowed to sign in
SESSION_SECRET=""                       # 32+ random bytes; rotates the admin cookie
#
# API-token fallback — needs SESSION_SECRET (above) and API_KEYS bootstrap tokens.
# Useful while waiting for an Apple Developer account. Disabled by default;
# set ADMIN_API_TOKEN_LOGIN to "true" to enable temporarily.
ADMIN_API_TOKEN_LOGIN=""

# Optional iOS app login. When enabled, the app can exchange a native Sign in
# with Apple identity token for a tenant API token and show that token to the user.
APPLE_APP_LOGIN_ENABLED=""              # set to "true" to enable
APPLE_APP_SIGN_IN_CLIENT_ID=""          # native app bundle id, e.g. com.example.zerozerowidget
