    "pretest": "npm run sync-docs",
    "pretypecheck": "npm run sync-docs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
