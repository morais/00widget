{
  "name": "zerozerowidget-server",
  "version": "0.1.0",
  "private": true,
  "description": "00Widget backend — Cloudflare Worker",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync-docs": "node scripts/sync-llms-md.mjs",
    "predev": "npm run sync-docs",
