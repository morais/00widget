name = "zerozerowidget-server"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Serve production only through the configured custom domain. Keeping both
# generated endpoints disabled prevents them bypassing controls on that domain.
workers_dev = false
preview_urls = false

[[routes]]
pattern = "api.example.com"
custom_domain = true

# Non-secret config. Secrets (API_KEYS, APNS_*) come from `wrangler secret put`
# or `.dev.vars` locally — see server/README.md.
[vars]
APNS_ENV = "sandbox"

# Associated domains. `<Team ID>.<bundle id>` — must match the app's
# DEVELOPMENT_TEAM and PRODUCT_BUNDLE_IDENTIFIER in ios/project.yml, and the
# domain here must be the one in that target's `applinks:` entitlement.
# Unset (as here) means /.well-known/apple-app-site-association returns 404,
# which is correct for a deployment with no app attached to it.
# APPLE_APP_ID = "ABCDE12345.com.example.zerozerowidget"
# APPLE_APP_CLIP_ID = "ABCDE12345.com.example.zerozerowidget.Clip"
# Whether signing in on the web can also *create* an account. Off unless "true":
# accounts are created in the iOS app, and someone who comes across this
# deployment without having used the app is turned away rather than provisioned.
# Web sign-in itself still works for everyone who already has an account —
# ADMIN_EMAILS names who additionally holds admin capabilities, it does not gate
# authenticating.
WEB_SIGNUP_ENABLED = "false"

# Master kill switch for the MCP endpoint (/mcp) and the OAuth authorization
# server that fronts it, which together let an MCP client — a ChatGPT
# connector, Claude, an editor — publish without anyone writing code. Anything
# other than "true" makes /mcp, /mcp.json, /oauth/* and the two OAuth
# .well-known documents return 404.
#
# Off by default because enabling it puts a browser sign-in flow that mints API
# tokens on the public internet. It also needs a strong SESSION_SECRET: MCP
# OAuth signs its client ids and authorization codes with it, and identifies the
# operator through the same admin session cookie the dashboard uses. Approving a
# connector is therefore an ADMIN_EMAILS action, and the credential it mints is
# an ordinary tenant API token, revocable from /admin like any other.
MCP_ENABLED = "false"

# Master kill switch for the cross-tenant sharing feature. Anything other
# than "true" disables every /v1/shares/* route and recipient push fanout.
# Off by default: sharing by activity_kind is coarse-grained — accepting a
# share for kind "progress" exposes every one of the owner's current *and
# future* "progress" Live Activities to the recipient. Opt in deliberately.
SHARING_ENABLED = "false"

# App Store subscriptions. Two flags rather than one, because the useful middle
# state is selling subscriptions without yet enforcing them — grandfathering
# existing tenants, or letting verification run for a while before it is allowed
# to reject anything.
#
# SUBSCRIPTIONS_ENABLED turns on /v1/subscription/* and the App Store Server
# Notifications endpoint. SUBSCRIPTION_REQUIRED additionally makes publish and
# actions:run return 402 without an active entitlement; reads are never gated,
# so a lapsed account's widgets keep showing what they last received rather than
# going blank with no explanation.
#
# Setting REQUIRED without ENABLED fails open, deliberately: a monetization
# switch that locks out every paying customer on a typo is worse than one that
# bills nobody.
SUBSCRIPTIONS_ENABLED = "false"
SUBSCRIPTION_REQUIRED = "false"

# Products this deployment sells, comma-separated, matching App Store Connect.
# Empty accepts any product signed for the right bundle id, which is only
# sensible in development.
# SUBSCRIPTION_PRODUCT_IDS = "com.example.zerozerowidget.pro.monthly,com.example.zerozerowidget.pro.yearly"

# "Production" (default) or "Sandbox". A sandbox purchase is free and unlimited,
# so one must never entitle a production tenant. Point a staging deployment at
# "Sandbox" and register the sandbox notification URL in App Store Connect.
# SUBSCRIPTION_ENVIRONMENT = "Production"

# Days past expiry an entitlement still counts. Covers a late notification, not
# a lapsed payment; Apple's own billing grace period arrives in the payload and
# is honoured separately, with whichever window reaches further winning.
# SUBSCRIPTION_GRACE_DAYS = "3"

# Optional: email the operator when self-service signup creates a new tenant.
# Commented out because it requires Cloudflare Email Routing on a domain in
# your account, and an uncommented binding would fail `wrangler deploy` for
# anyone who has not set that up. Worth enabling wherever
# APPLE_APP_LOGIN_ENABLED is "true", since tenant creation is otherwise silent.
#
# The destination address must be a verified Email Routing destination.
# [[send_email]]
# name = "SIGNUP_ALERTS"
# destination_address = "you@example.com"
#
# Then set the recipient (and optionally the sender, which must be on an
# Email Routing domain you control; it defaults to the recipient):
# SIGNUP_ALERT_TO = "you@example.com"
# SIGNUP_ALERT_FROM = "alerts@example.com"

# Create the D1 database first:
#   npx wrangler d1 create zerozerowidget
# Then paste the returned database_id below and run migrations:
#   npx wrangler d1 migrations apply zerozerowidget --remote
[[d1_databases]]
binding = "ZW_DB"
database_name = "zerozerowidget"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

# Authentication circuit breakers run before any D1 lookup. Namespace ids are
# deployment-local identifiers; keep each binding's id unique in your account.
[[ratelimits]]
name = "AUTH_SOURCE_LIMITER"
namespace_id = "10001"
  [ratelimits.simple]
  limit = 600
  period = 60

[[ratelimits]]
name = "AUTH_TOKEN_LIMITER"
namespace_id = "10002"
  [ratelimits.simple]
  limit = 300
  period = 60

[observability]
enabled = true

# No cron trigger: the Workers Free plan allows 5 per account and this one has
# none spare, so `wrangler deploy` fails the trigger update while still shipping
# the code. The expiry sweep instead rides the widget-reload queue consumer,
# sampled and under `waitUntil` (see maybeSweepRateLimitBuckets in index.ts).
# The `scheduled` handler stays wired to the same function, so uncommenting this
# on Workers Paid is all it takes to move the sweep onto a cron.
#
# [triggers]
# crons = ["0 * * * *"]

# One delayed message per receiving tenant drains its durable coalesced reload
# as soon as the 30-minute WidgetKit cadence window opens. Empty queues do not
# invoke the Worker.
[[queues.producers]]
binding = "WIDGET_RELOAD_QUEUE"
queue = "zerozerowidget-widget-reloads"

[[queues.consumers]]
queue = "zerozerowidget-widget-reloads"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 10
