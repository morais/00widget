name = "zerozerowidget-server"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Serve production only through the configured custom domain. Keeping both
# generated endpoints disabled prevents them bypassing controls on that domain.
workers_dev = false
preview_urls = false

[[routes]]
pattern = "api.example.com"
custom_domain = true

# Non-secret config. Secrets (API_KEYS, APNS_*) come from `wrangler secret put`
# or `.dev.vars` locally — see server/README.md.
[vars]
APNS_ENV = "sandbox"

# Associated domains. `<Team ID>.<bundle id>` — must match the app's
# DEVELOPMENT_TEAM and PRODUCT_BUNDLE_IDENTIFIER in ios/project.yml, and the
# domain here must be the one in that target's `applinks:` entitlement.
# Unset (as here) means /.well-known/apple-app-site-association returns 404,
# which is correct for a deployment with no app attached to it.
# APPLE_APP_ID = "ABCDE12345.com.example.zerozerowidget"
# APPLE_APP_CLIP_ID = "ABCDE12345.com.example.zerozerowidget.Clip"
# Master kill switch for the cross-tenant sharing feature. Anything other
# than "true" disables every /v1/shares/* route and recipient push fanout.
# Off by default: sharing by activity_kind is coarse-grained — accepting a
# share for kind "progress" exposes every one of the owner's current *and
# future* "progress" Live Activities to the recipient. Opt in deliberately.
SHARING_ENABLED = "false"

# Optional: email the operator when self-service signup creates a new tenant.
# Commented out because it requires Cloudflare Email Routing on a domain in
# your account, and an uncommented binding would fail `wrangler deploy` for
# anyone who has not set that up. Worth enabling wherever
# APPLE_APP_LOGIN_ENABLED is "true", since tenant creation is otherwise silent.
#
# The destination address must be a verified Email Routing destination.
# [[send_email]]
# name = "SIGNUP_ALERTS"
# destination_address = "you@example.com"
#
# Then set the recipient (and optionally the sender, which must be on an
# Email Routing domain you control; it defaults to the recipient):
# SIGNUP_ALERT_TO = "you@example.com"
# SIGNUP_ALERT_FROM = "alerts@example.com"

# Create the D1 database first:
#   npx wrangler d1 create zerozerowidget
# Then paste the returned database_id below and run migrations:
#   npx wrangler d1 migrations apply zerozerowidget --remote
[[d1_databases]]
binding = "ZW_DB"
database_name = "zerozerowidget"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

# Authentication circuit breakers run before any D1 lookup. Namespace ids are
# deployment-local identifiers; keep each binding's id unique in your account.
[[ratelimits]]
name = "AUTH_SOURCE_LIMITER"
namespace_id = "10001"
  [ratelimits.simple]
  limit = 600
  period = 60

[[ratelimits]]
name = "AUTH_TOKEN_LIMITER"
namespace_id = "10002"
  [ratelimits.simple]
  limit = 300
  period = 60

[observability]
enabled = true

# No cron trigger: the Workers Free plan allows 5 per account and this one has
# none spare, so `wrangler deploy` fails the trigger update while still shipping
# the code. The expiry sweep instead rides the widget-reload queue consumer,
# sampled and under `waitUntil` (see maybeSweepRateLimitBuckets in index.ts).
# The `scheduled` handler stays wired to the same function, so uncommenting this
# on Workers Paid is all it takes to move the sweep onto a cron.
#
# [triggers]
# crons = ["0 * * * *"]

# One delayed message per receiving tenant drains its durable coalesced reload
# as soon as the 30-minute WidgetKit cadence window opens. Empty queues do not
# invoke the Worker.
[[queues.producers]]
binding = "WIDGET_RELOAD_QUEUE"
queue = "zerozerowidget-widget-reloads"

[[queues.consumers]]
queue = "zerozerowidget-widget-reloads"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 10
