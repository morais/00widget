name = "zerozerowidget-server"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Non-secret config. Secrets (API_KEYS, APNS_*) come from `wrangler secret put`
# or `.dev.vars` locally — see server/README.md.
[vars]
APNS_ENV = "sandbox"
# Master kill switch for the cross-tenant sharing feature. Anything other
# than "true" disables every /v1/shares/* route and recipient push fanout.
SHARING_ENABLED = "true"

# Create the D1 database first:
#   npx wrangler d1 create zerozerowidget
# Then paste the returned database_id below and run migrations:
#   npx wrangler d1 migrations apply zerozerowidget --remote
[[d1_databases]]
binding = "ZW_DB"
database_name = "zerozerowidget"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[observability]
enabled = true

# One delayed message per receiving tenant drains its durable coalesced reload
# as soon as the 30-minute WidgetKit cadence window opens. Empty queues do not
# invoke the Worker.
[[queues.producers]]
binding = "WIDGET_RELOAD_QUEUE"
queue = "zerozerowidget-widget-reloads"

[[queues.consumers]]
queue = "zerozerowidget-widget-reloads"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 10
