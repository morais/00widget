## Per-developer defaults (gitignored). Copy from defaults.properties.sample.
## defaultBaseUrl is the fallback Worker URL when none is saved (editable
## on the developer screen unless the build provides one).
defaultBaseUrl=https://api.example.com
## applicationId is the store identity (namespace below stays fixed so R and
## BuildConfig imports never change). Keep com.example.* out of the store.
applicationId=com.example.zerozerowidget.hzos
