<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Stripped from the Horizon Platform SDK's manifest: legacy storage /
         phone-state permissions its abuse-report module declares but nothing
         in this app's send_auth_url usage touches. The store rejects
         READ_PHONE_STATE outright. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- No cloud backups: DataStore holds bearer API tokens, which must
         not ride along into device backups. Tokens are re-mintable. -->
    <application
        android:name=".ZeroZeroWidgetApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/PanelAppTheme"
        android:supportsRtl="true"
        android:allowBackup="false">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />

        <!-- Dashboard: the launcher panel. minWidth lets the shell shrink
             it below the 728dp two-column break (minus 40dp padding) so a
             narrow panel genuinely drops to one column. -->
        <activity
            android:theme="@style/PanelAppTheme.Transparent"
            android:name=".DashboardActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:minWidth="520dp"
                android:minHeight="500dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Singleton panels: reopening reuses the open instance (singleTask
             + NEW_TASK without MULTIPLE_TASK — see PanelLauncher). -->
        <activity
            android:theme="@style/PanelAppTheme.Transparent"
            android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <!-- Narrow by design: settings is a form, not a dashboard. Half
                 the old 900dp default; min follows so the shell can keep it
                 slim. Content scrolls, so nothing is lost to the width. -->
            <layout
                android:defaultWidth="480dp"
                android:defaultHeight="700dp"
                android:minWidth="360dp"
                android:minHeight="450dp" />
        </activity>

        <!-- Card detail: one instance per popped-out card (MULTIPLE_TASK),
             so N cards sit side by side as N shell panels. -->
        <activity
            android:theme="@style/PanelAppTheme.Transparent"
            android:name=".CardDetailActivity"
            android:exported="false"
            android:screenOrientation="landscape">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="700dp"
                android:minWidth="700dp"
                android:minHeight="450dp" />
        </activity>
    </application>
</manifest>
