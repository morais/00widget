<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque dark theme for shell panels. The system draws the panel
         chrome; the app fills its window normally (no translucency). -->
    <style name="PanelAppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
